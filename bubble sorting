package sorting;

public class BubbleSort {

    // Sorts the input array in ascending order and returns a new array.
    public int[] sort(int[] input) {
        // Clone the input so that the original array is not changed.
        int[] arr = input.clone();

        // Each pass moves the largest unsorted value to the end.
        for (int i = 0; i < arr.length - 1; i++) {
            // Tracks whether any swap happened during this pass.
            boolean swapped = false;

            // The last i elements are already in their correct positions.
            for (int j = 0; j < arr.length - i - 1; j++) {

                // If two neighbouring values are in the wrong order, swap them.
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];       // Temporarily save the left value.
                    arr[j] = arr[j + 1];     // Move the right value to the left.
                    arr[j + 1] = temp;       // Put the saved value on the right.
                    swapped = true;         // Record that a swap occurred.
                }
            }

            // If no swap occurred, the array is already sorted; stop early.
            if (!swapped) break;
        }

        return arr; // Return the sorted copy.
    }
}
